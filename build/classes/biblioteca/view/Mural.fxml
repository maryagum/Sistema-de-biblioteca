<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http:// his/fxml/1" fx:controller="biblioteca.controller.MuralController">
   <children>
      <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Mural de Avisos" textFill="#b22222">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      
      <HBox spacing="15.0">
         <children>
            <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dcdcdc; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Conexão com o Servidor" textFill="#1e3d59">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="txtIdGrupo" prefWidth="60.0" promptText="Nº" />
                        <Button fx:id="btnConectar" mnemonicParsing="false" onAction="#conectarServidor" style="-fx-background-color: #1565c0;" text="Conectar ao Servidor" textFill="white">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            
            <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dcdcdc; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblNomeGrupo" text="Grupo atual: Nenhum" textFill="#1565c0">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblTemaGrupo" text="Tema carregado: -" textFill="#757575" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            
            <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dcdcdc; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Mensagens carregadas" textFill="#2e7d32">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblStatus" text="Aguardando conexão..." textFill="#757575" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
      
      <SplitPane dividerPositions="0.4" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <items>
          <AnchorPane style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dcdcdc; -fx-border-radius: 8;">
               <children>
                  <VBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                     <children>
                        <Label text="Ranking Geral" textFill="#333333">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <TableView fx:id="tableRanking" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="colGrupo" prefWidth="200.0" text="Grupo" />
                            <TableColumn fx:id="colAcessos" prefWidth="100.0" text="Acessos" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
            
          <AnchorPane style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dcdcdc; -fx-border-radius: 8;">
               <children>
                  <VBox spacing="12.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                     <children>
                        <Label text="Aviso em Destaque" textFill="#333333">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        
                        <VBox style="-fx-background-color: #e3f2fd; -fx-background-radius: 8; -fx-border-color: #bbdefb; -fx-border-radius: 8;">
                           <children>
                              <Label fx:id="lblAvisoTitulo" text="Título do Aviso" textFill="#0d47a1">
                                 <font>
                                    <Font name="System Bold" size="16.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblAvisoDestaque" minHeight="50.0" text="Nenhuma mensagem recebida ainda. Conecte-se para iniciar a rotação automática do mural." wrapText="true" />
                              <Label fx:id="lblAvisoTimestamp" text="Recebido em: --" textFill="#757575">
                                 <font>
                                    <Font size="11.0" />
                                 </font>
                                 <VBox.margin>
                                    <Insets top="5.0" />
                                 </VBox.margin>
                              </Label>
                           </children>
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                        </VBox>
                        
                        <Label fx:id="lblContadorAvisos" text="0 avisos recebidos" textFill="#333333">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        
                        <Label text="Mensagens do Grupo">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <ListView fx:id="listViewMensagens" prefHeight="150.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
        </items>
      </SplitPane>
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</VBox>