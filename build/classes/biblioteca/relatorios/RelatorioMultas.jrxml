	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Conexao_Biblioteca"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    m.id AS id_multa,
    u.nome AS nome_usuario,
    l.nome AS nome_livro,
    m.valor,
    e.data_emprestimo,
    e.data_prevista_devolucao AS prazo
FROM Multa m
INNER JOIN Usuario u ON m.id_usuario = u.id
INNER JOIN Livro l ON m.id_livro = l.id
INNER JOIN Emprestimo e ON m.id_emprestimo = e.id
WHERE m.isQuitado = FALSE
ORDER BY m.valor DESC]]>
	</queryString>
