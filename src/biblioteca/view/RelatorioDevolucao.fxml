<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.controller.RelatorioDevolucaoController">
   <children>
      <Label AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" text="Relatório de Devoluções">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      
      <Label AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="65.0" prefWidth="360.0" text="Esta tela gera a listagem de todos os livros que já foram devolvidos, com as respectivas datas de empréstimo e prazos." wrapText="true" />
      
      <Button fx:id="btnImprimir" layoutX="65.0" layoutY="180.0" mnemonicParsing="false" onAction="#handleImprimir" prefHeight="45.0" prefWidth="120.0" text="Imprimir" AnchorPane.bottomAnchor="60.0" />
      
      <Button fx:id="btnVoltar" layoutX="215.0" layoutY="180.0" mnemonicParsing="false" onAction="#handleVoltar" prefHeight="45.0" prefWidth="120.0" text="Voltar" AnchorPane.bottomAnchor="60.0" />
   </children>
</AnchorPane>